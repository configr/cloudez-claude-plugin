{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/libexec/guard",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__cloudez__cloudez_(begin_deploy|finalize_deploy|rollback)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/libexec/guard",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
