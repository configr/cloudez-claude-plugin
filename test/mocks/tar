#!/usr/bin/env bash
# Mock de tar (lado local do transporte). Registra a invocacao e emite alguns
# bytes para o pipe, para que o fluxo ate o ssh seja realmente exercitado.
printf 'tar %s\n' "$*" >> "${MOCK_LOG:-/dev/null}"
[ -n "${MOCK_TAR_STDERR:-}" ] && printf '%s\n' "$MOCK_TAR_STDERR" >&2
printf 'MOCK_TAR_STREAM'
exit "${MOCK_TAR_EXIT:-0}"
