#!/usr/bin/env bash
# Uso: cloudez-begin-deploy <environment> <ref> <idempotency_key> [note]
#
# Registra a intencao de deploy e cria o diretorio de release remoto.
# Nao move nenhum byte — devolve o destino para o cloudez-sync.
# Equivalente a tool MCP cloudez_begin_deploy.

source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

environment="${1:?uso: cloudez-begin-deploy <environment> <ref> <idempotency_key> [note]}"
ref="${2:?ref (git SHA) obrigatorio}"
idem="${3:?idempotency_key obrigatorio}"
note="${4:-}"

site=$(site_config "$environment")
mkdir -p "$CLOUDEZ_STATE_DIR/key"

# Idempotencia: a mesma chave devolve o mesmo deploy, nunca cria outro.
key_file="$CLOUDEZ_STATE_DIR/key/$idem"
if [ -f "$key_file" ]; then
  load_state "$(cat "$key_file")"
  exit 0
fi

sha7=$(printf '%s' "$ref" | cut -c1-7)
release_id="$(date -u +%Y%m%dT%H%M%SZ)-$sha7"
deploy_id="dpl_$(printf '%s%s' "$release_id" "$idem" | shasum | cut -c1-8)"

root=$(site_root "$site" "$environment")
release_path="$root/releases/$release_id"

require_ssh_target "$site"

# Resolvido uma vez: o destino vai para o JSON de estado, e o cloudez-sync o le
# de la. Sem isso, o sync precisaria receber as mesmas variaveis de ambiente que
# o begin recebeu — e uma delas faltando produziria um envio para outro servidor.
host=$(ssh_target "$site" .ssh.host CLOUDEZ_SSH_HOST)
user=$(ssh_target "$site" .ssh.user CLOUDEZ_SSH_USER)
port=$(ssh_target "$site" .ssh.port CLOUDEZ_SSH_PORT 22)

if ! ssh_out=$(ssh_run "$site" "mkdir -p '$release_path' '$root/releases' '$root/shared'" 2>&1); then
  die ssh_failed "Nao foi possivel preparar o diretorio de release em $host." \
    "$(jq -n --arg l "$ssh_out" '{logs: $l, retryable: true}')"
fi

jq -n \
  --arg deploy_id "$deploy_id" \
  --arg release_id "$release_id" \
  --arg environment "$environment" \
  --arg ref "$ref" \
  --arg note "$note" \
  --arg host "$host" \
  --arg user "$user" \
  --argjson port "$port" \
  --arg path "$release_path/" \
  --arg root "$root" \
  '{
     deploy_id: $deploy_id,
     release_id: $release_id,
     environment: $environment,
     ref: $ref,
     note: $note,
     status: "awaiting_upload",
     ssh: {host: $host, user: $user, port: $port, path: $path},
     root: $root
   }' | tee "$(state_path "$deploy_id")"

printf '%s' "$deploy_id" > "$key_file"
