#!/usr/bin/env bash
# Uso: cloudez-approve <environment>
#
# Emite a aprovacao humana exigida pelo hook de guard-rail para ambientes
# protegidos. A aprovacao vale por guard.approval_ttl_minutes e so para o commit
# apontado por HEAD no momento da emissao.
#
# Exige TTY e confirmacao digitada de proposito: rodado pela tool Bash de um
# agente nao ha TTY e o comando falha. Isto e o que faz a aprovacao significar
# "um humano decidiu", e nao "o modelo decidiu por si".

source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

env="${1:?uso: cloudez-approve <environment>}"
site=$(site_config "$env")

if [ ! -t 0 ] || [ ! -r /dev/tty ]; then
  die no_tty "cloudez-approve exige um terminal interativo." \
    '{"hint":"Rode este comando no seu proprio terminal. Um agente nao pode se auto-aprovar."}'
fi

load_config
ttl=$(printf '%s' "$CLOUDEZ_CONFIG_JSON" | jq -r '.guard.approval_ttl_minutes // 15')
sha=$(git rev-parse HEAD 2>/dev/null || echo "")
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
subject=$(git log -1 --pretty=%s 2>/dev/null || echo "?")

cat >&2 <<EOF

  Aprovacao de deploy
  ───────────────────────────────────────────────
  ambiente   $env
  destino    $(cfg "$site" .health_url)
  servidor   $(cfg "$site" .ssh.user)@$(cfg "$site" .ssh.host):$(cfg "$site" .paths.root)
  branch     $branch
  commit     ${sha:0:7}  $subject
  validade   $ttl minutos, apenas para este commit
  ───────────────────────────────────────────────

EOF

printf 'Digite o nome do ambiente para confirmar (%s): ' "$env" >&2
read -r answer < /dev/tty

if [ "$answer" != "$env" ]; then
  die approval_declined "Confirmacao nao conferiu. Nada foi aprovado."
fi

mkdir -p "$CLOUDEZ_STATE_DIR"
jq -n \
  --arg env "$env" --arg sha "$sha" --arg branch "$branch" \
  --argjson epoch "$(date +%s)" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --argjson ttl "$ttl" --arg by "${USER:-desconhecido}" \
  '{environment:$env, sha:$sha, branch:$branch,
    approved_at_epoch:$epoch, approved_at:$at,
    ttl_minutes:$ttl, approved_by:$by}' \
  | tee "$CLOUDEZ_STATE_DIR/approval-$env.json"

printf '\nAprovado. O deploy para %s esta liberado pelos proximos %s minutos.\n' "$env" "$ttl" >&2
