#!/bin/sh
# Launcher POSIX: seleciona o binario da plataforma atual.
#
# Existe porque quem chama usa um nome so — `cloudez-sync` — e o binario e por
# sistema e arquitetura. No Windows o par deste script e o .cmd ao lado, que o
# PATHEXT resolve a partir do mesmo nome.
#
# O alvo sai do proprio nome do arquivo, com o prefixo `cloudez-` removido, para
# que o mesmo script sirva a qualquer comando futuro sem uma copia editada.
#
# `exec` e importante: substitui o processo, entao o codigo de saida do binario
# chega intacto a quem chamou.

# CDPATH atrapalha: com ele setado, `cd` imprime o destino no stdout e polui a
# substituicao de comando.
unset CDPATH

dir=$(cd -- "$(dirname -- "$0")" && pwd)

name=$(basename -- "$0")
name=${name#cloudez-}

# O launcher vive em bin/, mas tolera ser chamado de dentro do proprio libexec/.
libexec="$dir"
[ -d "$dir/../libexec" ] && libexec=$(cd -- "$dir/../libexec" && pwd)

os=$(uname -s | tr '[:upper:]' '[:lower:]')
arch=$(uname -m)
case "$arch" in
  x86_64|amd64)  arch=amd64 ;;
  arm64|aarch64) arch=arm64 ;;
esac

# Windows chega aqui por bash — Git Bash, MSYS2, Cygwin — e nenhum deles diz
# "windows" no `uname -s`: sai `MINGW64_NT-10.0-22631`, `MSYS_NT-...` ou
# `CYGWIN_NT-...`, com a versao do sistema embutida no nome.
#
# Sem este mapeamento o script procurava `sync-mingw64_nt-10.0-22631-amd64` e
# falhava com "binario ausente para mingw64_nt-10.0-22631/amd64" — que se le
# como "nao foi compilado para Windows", quando o .exe estava ali ao lado o
# tempo todo. O par .cmd nunca viu esse problema, e por isso o defeito passou:
# ele so aparece quando alguem chama o plugin de dentro de um bash no Windows.
ext=
case "$os" in
  mingw*|msys*|cygwin*) os=windows; ext=.exe ;;
esac

bin="$libexec/$name-$os-$arch$ext"

# `-x` no lugar de `-f` em toda parte menos Windows: e o bit de execucao que
# distingue um binario utilizavel de um arquivo truncado por um checkout pela
# metade. Em Windows nao ha esse bit — dependendo de como o volume esta montado,
# o bash reporta todo .exe como executavel ou nenhum —, entao la a pergunta que
# resta e se o arquivo existe.
if [ "$os" = windows ]; then
  existe() { [ -f "$1" ]; }
else
  existe() { [ -x "$1" ]; }
fi

if ! existe "$bin"; then
  echo "cloudez: binario '$name' ausente para $os/$arch ($bin)." >&2
  echo "cloudez: rode ./build.sh no diretorio do plugin." >&2
  exit 1
fi

exec "$bin" "$@"
