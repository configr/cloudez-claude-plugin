#!/usr/bin/env node
// Uso: cloudez-setup <domain> <environment>
//
// Cria o .cloudez.yaml do projeto, com o bloco do environment pedido, quando
// ainda não existe um. Não é erro rodar duas vezes: com config presente ele
// reporta e sai sem tocar no arquivo. Sobrescrever apagaria o root e os outros
// environments — o root é a decisão mais destrutiva do deploy, e quem o ajustou
// à mão não vai reescrever o mesmo valor de memória.
//
// ─── Por que Node, e não shell ──────────────────────────────────────────────
//
// Este era o último adaptador em bash, e sustentava sozinho três arquivos de
// apoio que só existiam por causa dele: `_lib.sh` (construir JSON, validar
// FQDN), `_json.mjs` (o Node que o shell chamava para escrever JSON, com uma
// minilinguagem de prefixos `:` e `+`) e `_yaml.sh` (achar o arquivo de config).
// Eram 174 linhas de andaime para 95 de conteúdo.
//
// Com Node 20+ como pré-requisito declarado do plugin, o andaime todo sai: o
// objeto é escrito como objeto, e o resto é `fs`. Some junto a última limitação
// de Windows que o README registrava — este arquivo não precisa de bash, e por
// isso também não precisa de um par `.cmd` para ser alcançável pelo cmd.
//
// O arquivo NÃO tem extensão de propósito: `cloudez-setup` é o nome que o
// usuário digita e que o allowlist autoriza. Quem informa ao Node que isto é um
// módulo ES é o `bin/package.json` — ver a nota no cloudez-login.
//
// ─── O que este adaptador não faz ───────────────────────────────────────────
//
// Não exige token, e não confirma que o domínio existe na conta. Quem confirma é
// a tool `cloudez_get_site` do MCP, chamada pelo /cloudez:setup antes de chegar
// aqui — este adaptador não fala com a Cloudez, por desenho: o control plane é
// do MCP.
//
// Isso significa que a checagem NÃO é invariante deste script. Rodado direto,
// ele escreve config para qualquer FQDN bem formado, exista ou não. É uma
// consequência aceita: a confirmação depende de rede e credencial, que são
// justamente o que este adaptador não tem. Quem garante a ordem é o
// commands/setup.md.
//
// Ele continua fora do MCP porque **escreve no projeto do usuário**. Ler a
// máquina local nunca foi razão para ficar de fora — o servidor roda na mesma
// máquina —, mas gravar é decisão de outra ordem, e merece a discussão de onde
// o servidor tem permissão para escrever antes de migrar.

import { execFileSync } from "node:child_process"
import { appendFileSync, existsSync, readFileSync, writeFileSync } from "node:fs"

import { die, ok } from "./_out.mjs"

// ─────────────────────────────────────────────────────────────────── domínio ──

/**
 * FQDN e nada mais: protocolo, caminho, querystring ou porta reprovam.
 *
 * O domínio identifica o site E vira caminho no servidor, então um valor solto
 * aqui reaparece longe da causa — como um diretório sem sentido em `~/`.
 */
function isFqdn(valor) {
  return valor.length <= 253 && /^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$/.test(valor)
}

// ────────────────────────────────────────────────────────────────── config ──

/**
 * Onde mora a config do projeto: o arquivo existente, ou `.cloudez.yaml` como
 * destino padrão quando não há nenhum. Serve para as duas metades da decisão.
 *
 * Houve aqui um conversor YAML→JSON com quatro parsers alternativos (yq nas duas
 * implementações incompatíveis, python3 com PyYAML, ruby). Ele saiu junto com os
 * adaptadores de deploy, e o comentário que ficou dizia que "quem lê a config
 * agora é o servidor MCP" — o que nunca foi verdade. **Ninguém** parseia este
 * arquivo em código: as tools de deploy recebem `domain` e `root` como
 * argumento, e quem lê o YAML é o modelo, com a tool Read. O que sobra aqui é
 * saber ONDE ele fica, e só.
 */
function resolveConfig() {
  if (process.env.CLOUDEZ_CONFIG) return process.env.CLOUDEZ_CONFIG
  // `.yaml` vence `.yml` quando os dois existem: é o nome que o setup gera.
  for (const nome of [".cloudez.yaml", ".cloudez.yml"]) {
    if (existsSync(nome)) return nome
  }
  return ".cloudez.yaml"
}

// ─────────────────────────────────────────────────────────────────── database ──

/**
 * Escreve `database:` no bloco do environment, num arquivo que JÁ EXISTE.
 *
 * Linha a linha, e não parse-e-reserialize. Um round-trip de YAML reescreveria o
 * arquivo inteiro — comentários, ordem das chaves, aspas, os outros environments —
 * e este arquivo guarda o `root`, que é o valor mais destrutivo do plugin. Trocar
 * uma linha é o que se pede; reescrever tudo é o que se paga.
 *
 * Devolve `{ status }`: "added", "updated" ou "unchanged".
 */
function gravarDatabase(caminho, environment, valor) {
  const linhas = readFileSync(caminho, "utf8").split("\n")

  // O bloco do environment: uma chave de segundo nível sob `cloudez:`. A
  // indentação é a do arquivo, e não a que este programa gera — quem editou à mão
  // pode ter usado outra, e reindentar seria reescrever o que não foi pedido.
  const iEnv = linhas.findIndex((l) => new RegExp(`^\\s+${environment}:\\s*$`).test(l))
  if (iEnv === -1) {
    die("environment_not_found", `O environment '${environment}' nao esta em ${caminho}.`, {
      hint: "Rode o setup para o environment que existe, ou acrescente o bloco antes.",
    })
  }

  const recuo = /^(\s+)/.exec(linhas[iEnv])[1]
  // Fim do bloco: a primeira linha com conteúdo cujo recuo não é MAIOR que o da
  // chave do environment. Sem isso, a chave iria parar no bloco do vizinho.
  let fim = iEnv + 1
  while (fim < linhas.length) {
    const l = linhas[fim]
    if (l.trim() !== "" && !new RegExp(`^${recuo}\\s`).test(l)) break
    fim++
  }

  const iDb = linhas.slice(iEnv + 1, fim).findIndex((l) => /^\s+database:/.test(l))

  // O recuo dos IRMÃOS, e não `recuo + 2`: um arquivo escrito à mão com quatro
  // espaços receberia a chave com seis, e o YAML sairia quebrado. Medido. O
  // fallback só vale para um bloco sem nenhum filho, que o setup nunca gera.
  const irmao = linhas.slice(iEnv + 1, fim).find((l) => l.trim() !== "")
  const recuoFilho = irmao ? /^(\s*)/.exec(irmao)[1] : `${recuo}  `

  if (iDb !== -1) {
    const alvo = iEnv + 1 + iDb
    const atual = linhas[alvo].split(":").slice(1).join(":").trim()
    if (atual === valor) return { status: "unchanged" }
    linhas[alvo] = `${recuoFilho}database: ${valor}`
    writeFileSync(caminho, linhas.join("\n"))
    return { status: "updated", previous: atual }
  }

  // Entra no FIM do bloco, e não logo abaixo da chave: assim ele fica ao lado de
  // `domain` e `root` em vez de na frente deles.
  let ultima = fim
  while (ultima > iEnv + 1 && linhas[ultima - 1].trim() === "") ultima--
  linhas.splice(ultima, 0, `${recuoFilho}database: ${valor}`)
  writeFileSync(caminho, linhas.join("\n"))
  return { status: "added" }
}

// ────────────────────────────────────────────────────────────────── gitignore ──

/**
 * Garante `.cloudez/` no .gitignore: "updated" | "already" | "skipped".
 *
 * O estado dos deploys mora em `.cloudez/` e não deveria ir para o repositório.
 * É feito aqui porque é o passo que todo mundo esquece, e esquecer significa
 * commitar estado de servidor.
 *
 * Quem responde se há repositório é o próprio git, e não uma busca por `.git`
 * subindo os diretórios: em worktree e submódulo o `.git` é um arquivo, e
 * `GIT_DIR` no ambiente muda a resposta. Fora de um repositório o comando falha,
 * e "skipped" é resultado, não erro.
 */
function garantirGitignore() {
  try {
    execFileSync("git", ["rev-parse", "--git-dir"], { stdio: "ignore" })
  } catch {
    return "skipped"
  }

  let atual = ""
  try {
    atual = readFileSync(".gitignore", "utf8")
  } catch {
    // Não existe ainda. O append cria.
  }

  if (/^\.cloudez\/?$/m.test(atual)) return "already"

  // Um arquivo sem newline final grudaria as duas linhas numa só.
  appendFileSync(".gitignore", (atual && !atual.endsWith("\n") ? "\n" : "") + ".cloudez/\n")
  return "updated"
}

// ───────────────────────────────────────────────────────────────── entrada ──

const argv = process.argv.slice(2)

/**
 * Onde o banco de produção mora. Fica no `.cloudez.yaml` porque é uma decisão do
 * PROJETO, tomada uma vez com o usuário, e relida por todo passo que vem depois —
 * o backup, um deploy futuro, outra sessão. Derivar do docker-compose seria
 * inferência: `profiles: ["dev"]` no `db` SUGERE banco gerenciado, e sugestão não
 * é registro.
 */
const BANCOS = ["cloudez", "docker"]

let database
const iDb = argv.indexOf("--database")
if (iDb !== -1) {
  database = argv[iDb + 1]
  argv.splice(iDb, 2)
  if (!BANCOS.includes(database)) {
    die("invalid_database", `Valor invalido para --database: '${database ?? ""}'.`, {
      hint: `Os aceitos sao: ${BANCOS.join(", ")}. 'cloudez' e a instancia gerenciada; 'docker' e o container com volume nomeado.`,
    })
  }
}

const [bruto, environment] = argv

if (!bruto) {
  die("missing_domain", "Informe o dominio: cloudez-setup <domain> <environment>.", {
    hint: "FQDN, sem protocolo nem caminho. Ex.: staging.meusite.com.br",
  })
}

// DNS não diferencia maiúscula, mas o caminho no servidor diferencia: o domínio
// vira `~/<domain>/www/claude`, então normalizar aqui evita dois diretórios para
// o mesmo site.
const domain = bruto.toLowerCase()

if (!isFqdn(domain)) {
  die("invalid_domain", `'${bruto}' nao e um FQDN valido.`, {
    hint: "Use apenas o dominio: meusite.com.br. Sem https://, sem /caminho, sem ?query, sem :porta.",
  })
}

if (!environment) {
  die("missing_environment", "Informe o environment: cloudez-setup <domain> <environment>.", {
    hint: "Ex.: default, staging, production. Nao ha padrao — o environment decide para onde o deploy vai.",
  })
}

// O environment vira chave YAML e é interpolado no template. Restringir o
// formato aqui é o que impede um nome com espaço ou dois-pontos de gerar um
// arquivo quebrado que o usuário não escreveu.
if (!/^[A-Za-z0-9][A-Za-z0-9_-]*$/.test(environment)) {
  die("invalid_environment", `Nome de environment invalido: '${environment}'.`, {
    hint: "Use letras, numeros, hifen ou underscore. Ex.: default, staging, production.",
  })
}

const target = resolveConfig()

if (existsSync(target)) {
  // Sem `--database`, nada muda: sobrescrever apagaria o root e os outros
  // environments. Com ele, mexe-se numa chave só.
  if (database === undefined) ok({ status: "exists", path: target, domain, environment })
  ok({ ...gravarDatabase(target, environment, database), path: target, domain, environment, database })
}

// Só domain e root. O destino ssh saiu daqui: ele vem da conta do usuário, pelo
// cloudez_get_site, e uma cópia num arquivo versionado envelheceria — a Cloudez
// pode mover o site de servidor, e o host escrito continuaria apontando para o
// antigo, mandando o deploy para o lugar errado sem reclamar.
//
// O arquivo gerado não leva comentário nenhum: é config de projeto, versionada e
// lida por quem já sabe o que está fazendo. O que os comentários explicavam —
// para onde o deploy publica, e que o document root no painel precisa apontar
// para <root>/current — é trabalho do /cloudez:setup dizer na conversa, onde o
// usuário ainda pode perguntar. No arquivo, viravam texto que ninguém relê e que
// envelhece sozinho.
const linhaDb = database ? `    database: ${database}\n` : ""
writeFileSync(
  target,
  `cloudez:\n  ${environment}:\n    domain: ${domain}\n    root: ~/${domain}/www/claude\n${linhaDb}`,
)

// Sem `todo`: não sobra nada para o usuário preencher. O destino ssh vem do
// cloudez_get_site, e o root já sai escrito.
ok({
  status: "created",
  path: target,
  domain,
  environment,
  ...(database ? { database } : {}),
  gitignore: garantirGitignore(),
})
