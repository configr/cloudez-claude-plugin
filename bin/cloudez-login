#!/usr/bin/env node
// Uso: cloudez-login [--stdin]
//
//   --stdin      lê o token de um pipe, sem prompt e sem terminal:
//                  pbpaste | cloudez-login --stdin        (macOS, token no clipboard)
//                  echo "$CLOUDEZ_TOKEN" | ... --stdin    (CI)
//   (sem flag)   pergunta o token e salva. Exige terminal.
//
// ─── Por que Node, e não shell ──────────────────────────────────────────────
//
// Isto era bash que chamava Node para escrever JSON. O `bin/_json.mjs` nasceu
// para tirar o `jq` da lista de dependências, e trouxe junto uma minilinguagem
// de prefixos (`:chave` para literal, `+chave` para mesclar na raiz) que existia
// só porque quem construía o objeto era um shell. Um dos comentários de lá
// registrava o preço: `:verified` precisava do prefixo, senão a string "false"
// passaria por verdadeiro em JavaScript — um defeito que só é possível quando um
// lado monta texto e o outro parseia.
//
// Com Node 20+ como pré-requisito declarado do plugin, nada disso se paga:
// `JSON.stringify` escapa igual, `fetch` dispensa o `curl`, e some a pergunta de
// se existe bash na máquina. É a mesma decisão que já tinha sido tomada para o
// `cloudez-sync` (Go) e para o servidor MCP.
//
// ─── O que NÃO mudou, e não muda ────────────────────────────────────────────
//
// Token é a única forma de autenticar. Existiu um modo --password (e-mail, senha
// e 2FA, batendo em POST /auth/login/); foi removido de propósito — veja a nota
// em docs/mcp-tool-contract.md, que guarda o que já foi descoberto da API para
// não ser redescoberto do zero.
//
// O modo interativo EXIGE TTY, e isso não vem de dependência nenhuma: um token
// digitado na conversa entra no contexto do modelo e no transcript da sessão,
// que o usuário não controla e não consegue limpar. No Claude Code o jeito de
// chamar é prefixar com `!`, que executa no terminal da sessão — a tool Bash não
// serve, ali /dev/tty responde "Device not configured".
//
// O --stdin existe porque um pipe resolve o mesmo problema sem terminal: o
// segredo vai da origem (clipboard, arquivo, variável) direto para o processo,
// sem passar pelo contexto de ninguém. Quem chama nunca vê o valor — e é isso
// que permite rodar pela tool Bash sem vazar nada. O que NÃO vale é o próprio
// agente montar o pipe com um token que ele conhece: se ele conhece, já vazou.
//
// O token não aparece em nenhuma saída deste script, nem truncado.
//
// Este script SÓ coleta e grava. Consultar o estado da autenticação é com a tool
// `cloudez_auth_status` do MCP: é o MCP que usa o token contra a API, e ter duas
// noções de "estou autenticado" em lugares diferentes só cria a divergência em
// que uma diz sim e a outra diz não. Ela também é quem diz COMO autenticar nesta
// máquina — existiu um `--hint` aqui para isso, e saiu quando o servidor passou
// a ser distribuído dentro do plugin. Ver login-hint.ts, no repositório do MCP.

// O arquivo NAO tem extensao, de proposito: `cloudez-login` e o nome que o
// usuario digita, que a doc cita e que o allowlist autoriza. O preco disso e que
// o Node precisa ser informado de que isto e um modulo ES — sem extensao e sem
// aviso ele assume CommonJS, e o `import` abaixo vira erro de sintaxe.
//
// Quem informa e o `bin/package.json`, com `{"type": "module"}`. Node 22+ detecta
// sozinho pela sintaxe, e por isso o problema fica INVISIVEL em maquina moderna:
// so aparece no Node 20, que e o piso declarado do plugin. Ha um teste que roda
// este arquivo com `--no-experimental-detect-module` justamente para nao
// depender da versao de quem rodar a suite.

import { openSync } from "node:fs"
import { ReadStream } from "node:tty"
import { fileURLToPath } from "node:url"

// ───────────────────────────────────────────────────────────────────── saída ──
//
// O envelope — sucesso em stdout, erro em stderr, JSON nos dois — é o mesmo do
// cloudez-setup, e por isso mora fora daqui. Ver bin/_out.mjs.

import { die, ok } from "./_out.mjs"

// ─────────────────────────────────────────────────────────────────── token ──
//
// Nada disto é implementado aqui. `mcp/cloudez-auth.mjs` é um bundle do mesmo
// código que o servidor MCP usa: mesma precedência CLOUDEZ_TOKEN > arquivo,
// mesmo `Authorization: Token`, mesma tabela de vereditos, mesma ordem de
// gravar-depois-validar.
//
// Antes havia duas implementações — esta e a do MCP —, e o comentário que ficava
// aqui admitia o arranjo: "são duas implementações de um contrato, não duas
// opiniões". Era uma promessa sustentada só pela disciplina de quem edita, e o
// modo de falha era o pior possível de diagnosticar: o login dizendo que está
// autenticado e o MCP dizendo que não.
//
// O que segurava a duplicação era este arquivo ser shell — não havia como
// importar TypeScript de um script bash. Com ele em Node, deixou de haver razão.
//
// O import é do BUNDLE de biblioteca, não do servidor: `mcp/cloudez-mcp.mjs`
// sobe um transporte stdio ao ser importado, e penduraria este processo.

import { resolveToken, saveToken, tokenFile, tokenSource, verifyToken } from "../mcp/cloudez-auth.mjs"

// ────────────────────────────────────────────────────────────────── resposta ──

async function statusJson(status, verified) {
  const base = { status, source: await tokenSource(), token_file: tokenFile(), verified }
  if (verified) return ok(base)
  return ok({
    ...base,
    warning:
      "Não foi possível confirmar o token com a API da Cloudez (offline ou API fora). " +
      "O token foi aceito como está.",
  })
}

/**
 * Grava, e transforma a recusa da Cloudez em erro deste comando.
 *
 * O `saveToken` da biblioteca não lança: devolve o veredito com o arquivo já
 * restaurado. Que isso seja fatal, com que código, e o que se imprime — é
 * política, e política fica em quem tem interface com gente.
 */
async function gravarOuMorrer(token) {
  const { verdict, restored } = await saveToken(token)

  if (verdict === "invalid") {
    die("invalid_token", "A Cloudez recusou este token.", {
      hint:
        "Confira se o token foi copiado inteiro e se não foi revogado no painel. " +
        (restored ? "O token anterior foi mantido." : "Nada foi salvo."),
    })
  }

  await statusJson("authenticated", verdict === "valid")
}

// Espaço no meio não é token: é uma linha inteira copiada por engano, ou o
// clipboard com outra coisa. Recusar aqui evita gastar uma chamada de API para
// descobrir o óbvio.
function recusarSeNaoParecerToken(token, origem, hint) {
  if (/\s/.test(token)) die("invalid_token", `${origem} tem espaços — não parece um token.`, { hint })
}

// ──────────────────────────────────────────────────────────────────── prompt ──

// As três teclas que o modo raw entrega cruas, e que por isso precisam de nome.
const ETX = "\u0003" // Ctrl-C
const EOT = "\u0004" // Ctrl-D, fim de entrada
const DEL = "\u007f" // backspace, como o terminal o manda

/**
 * Lê o token do terminal, sem eco.
 *
 * Modo raw em vez de readline: readline só esconde o que é digitado mexendo num
 * método privado (`_writeToOutput`), e um segredo não é lugar para depender de
 * API interna. O preço do raw é tratar backspace e Ctrl-C na mão — sem isso o
 * Ctrl-C não chega ao processo e o terminal fica preso.
 *
 * O prompt e a moldura vão para stderr: stdout é do payload.
 */
function pedirToken(terminal) {
  terminal.setRawMode(true)
  terminal.setEncoding("utf8")
  process.stderr.write("Token: ")

  return new Promise((resolve, reject) => {
    let buffer = ""

    const encerrar = (fn, arg) => {
      terminal.setRawMode(false)
      terminal.pause()
      process.stderr.write("\n")
      fn(arg)
    }

    terminal.on("data", (chunk) => {
      for (const ch of chunk) {
        if (ch === "\r" || ch === "\n" || ch === EOT) return encerrar(resolve, buffer)
        if (ch === ETX) return encerrar(reject, new Error("interrompido"))
        if (ch === DEL || ch === "\b") buffer = buffer.slice(0, -1)
        else buffer += ch
      }
    })
  })
}

/**
 * O terminal de controle, ou `null` se não houver.
 *
 * `/dev/tty` é o terminal de controle no POSIX, e é ele que precisa existir —
 * stdin pode estar redirecionado sem que o terminal tenha sumido. No Windows ele
 * não existe: ali o console é o próprio stdin.
 */
function abrirTerminal() {
  try {
    return new ReadStream(openSync("/dev/tty", "r"))
  } catch {
    return process.platform === "win32" && process.stdin.isTTY ? process.stdin : null
  }
}

// ─────────────────────────────────────────────────────────────────── entrada ──

const modo = process.argv[2] ?? ""

if (modo === "--stdin") {
  // Sem pipe isso travaria esperando entrada que nunca vem, e o usuário não
  // teria como saber por quê. O modo interativo é o default, sem flag.
  if (process.stdin.isTTY) {
    die("usage", "--stdin espera o token num pipe, não num terminal.", {
      hint: "Ex.: pbpaste | cloudez-login --stdin. Para digitar o token, rode cloudez-login sem argumento.",
    })
  }

  let bruto = ""
  process.stdin.setEncoding("utf8")
  for await (const parte of process.stdin) bruto += parte
  const token = bruto.replace(/[\r\n]/g, "").trim()

  if (!token) {
    die("empty_token", "Nada chegou pelo pipe. Nada foi salvo.", {
      hint: "Se o token vinha do clipboard, confira se ele foi copiado.",
    })
  }

  recusarSeNaoParecerToken(token, "O que chegou pelo pipe", "Copie apenas o token, sem rótulo nem URL em volta.")

  await gravarOuMorrer(token)
}

// Única lápide que sobrou. Existiu uma segunda, para o `--check`, e ela saiu:
// aquele modo virou tool há muito tempo, e o erro genérico de argumento
// desconhecido já cita a `cloudez_auth_status`. Esta fica porque o que mudou não
// foi ONDE, foi O QUE: login por senha não existe mais em lugar nenhum, e um
// "argumento desconhecido" mandaria a pessoa procurar a flag certa.
if (modo === "--password") {
  die("password_login_disabled", "Login por e-mail e senha foi descontinuado.", {
    hint: "Gere um token no painel da Cloudez e rode cloudez-login sem argumento.",
  })
}

if (modo) {
  die("usage", `Argumento desconhecido: '${modo}'.`, {
    hint:
      "Uso: cloudez-login [--stdin]. Para saber se há token e como autenticar nesta " +
      "máquina, chame a tool cloudez_auth_status — foi para lá que o antigo --check foi.",
  })
}

// ────────────────────────────────────────────────────────── token do painel ──

const terminal = process.stdin.isTTY ? abrirTerminal() : null

if (!terminal) {
  // O caminho absoluto porque bin/ só está no PATH da tool Bash, não no terminal
  // do usuário. Aqui ele é o próprio arquivo — não há detecção de clipboard:
  // essa parte da dica vive no `cloudez_auth_status`, que responde antes de
  // alguém chegar a executar este script.
  const self = fileURLToPath(import.meta.url)
  die("no_tty", "cloudez-login exige um terminal interativo.", {
    claude_code_command: `! ${self}`,
    hint: `Peça ao usuário para enviar: ! ${self} — o ! executa no terminal da sessão, onde existe TTY.`,
    reason:
      "Um token digitado na conversa entra no contexto do modelo e no transcript. " +
      "O prompt precisa rodar no terminal do usuário.",
  })
}

const existente = await resolveToken()
const existenteValido = Boolean(existente) && (await verifyToken(existente)) === "valid"

process.stderr.write(
  "\n  Login Cloudez\n" +
    "  ───────────────────────────────────────────────\n" +
    "  Gere um token no painel da Cloudez e cole abaixo.\n" +
    `  O token vai para ${tokenFile()}, com permissão 0600.\n` +
    "  Nada é digitado na tela.\n",
)

if (existenteValido) {
  // Sem esta saída não havia como trocar um token válido por outro sem apagar o
  // arquivo na mão — e rotacionar token no painel é rotina, não exceção.
  process.stderr.write("  Já existe um token válido aqui. Enter mantém o atual.\n")
}
process.stderr.write("  ───────────────────────────────────────────────\n\n")

let digitado
try {
  digitado = (await pedirToken(terminal)).trim()
} catch {
  die("interrupted", "Login cancelado. Nada foi salvo.")
}

if (!digitado) {
  if (!existenteValido) die("empty_token", "Nenhum token informado. Nada foi salvo.")
  await statusJson("already_authenticated", true)
}

recusarSeNaoParecerToken(digitado, "O valor colado", "Cole apenas o token, sem o rótulo nem a URL do painel.")

await gravarOuMorrer(digitado)
