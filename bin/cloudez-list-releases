#!/usr/bin/env bash
# Uso: cloudez-list-releases <environment>
#
# Equivalente a tool MCP cloudez_list_releases.

source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

environment="${1:?uso: cloudez-list-releases <environment>}"
site=$(site_config "$environment")
root=$(site_root "$site" "$environment")

require_ssh_target "$site"

# O stderr do ssh fica FORA do $out, num arquivo a parte.
#
# Com `2>&1` ele entrava na mesma variavel que os dados, e a saida do ssh nao e
# so a do comando remoto: `StrictHostKeyChecking=accept-new` imprime
# "Warning: Permanently added ... to the list of known hosts" na PRIMEIRA
# conexao a um host — exatamente o cenario do primeiro deploy.
#
# Esse aviso virava uma release na lista, e o estrago acontecia no
# cloudez-rollback: ele escolhe a primeira release que nao e a atual, entao o
# alvo do rollback virava o texto do aviso. O symlink apontava para
# `releases/Warning: ...`, que nao existe, e o site respondia 404 com o
# adaptador reportando `rolled_back`.
err=$(mktemp)
trap 'rm -f "$err"' EXIT

if ! out=$(ssh_run "$site" \
      "current=\$(readlink '$root/current' 2>/dev/null | xargs -r basename)
       echo \"CURRENT \$current\"
       ls -1dt '$root/releases/'*/ 2>/dev/null | xargs -rn1 basename" 2>"$err"); then
  die ssh_failed "Nao foi possivel listar as releases." \
    "$(jq -n --arg l "$(cat "$err")" '{logs: $l, retryable: true}')"
fi

current=$(printf '%s\n' "$out" | awk '/^CURRENT /{print $2}')

# Filtra pelo MARCADOR, nao pela posicao. O `tail -n +2` de antes assumia que a
# linha 1 era o CURRENT: bastava uma linha inesperada na frente para ele
# descartar a linha errada e promover o proprio CURRENT a release.
printf '%s\n' "$out" | grep -v '^CURRENT ' | jq -R -s \
  --arg environment "$environment" --arg current "$current" \
  'split("\n") | map(select(length > 0))
   | {environment: $environment,
      releases: map({release_id: ., current: (. == $current)})}'
