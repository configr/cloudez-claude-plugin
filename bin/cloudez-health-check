#!/usr/bin/env bash
# Uso: cloudez-health-check <environment> [path] [expect_status]
#
# Verificacao HTTP do site. Equivalente a tool MCP cloudez_health_check.
# Sai com codigo 1 quando nao esta saudavel, para uso direto em `if`.

source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"
need curl

env="${1:?uso: cloudez-health-check <environment> [path] [expect_status]}"
path="${2:-/}"
expect="${3:-200}"

site=$(site_config "$env")
base=$(cfg "$site" .health_url)
[ -n "$base" ] || die config_invalid "health_url nao definido para o ambiente '$env'."

url="${base%/}$path"
timeout=$(cfg "$site" .health_timeout_s 10)

body_file=$(mktemp)
trap 'rm -f "$body_file"' EXIT

# O \n no -w nao e cosmetico: sem newline final o `read` retorna nao-zero ao
# bater no EOF e o `set -e` mata o script antes de imprimir o resultado.
read -r code latency < <(
  curl -sS -o "$body_file" -w '%{http_code} %{time_total}\n' \
       --max-time "$timeout" "$url" 2>/dev/null || printf '000 0\n'
)

healthy=false
[ "$code" = "$expect" ] && healthy=true

jq -n \
  --argjson healthy "$healthy" \
  --arg url "$url" \
  --arg status_code "$code" \
  --arg latency "$latency" \
  --arg excerpt "$(head -c 500 "$body_file")" \
  '{healthy: $healthy, url: $url,
    status_code: ($status_code | tonumber),
    latency_ms: (($latency | tonumber) * 1000 | floor),
    body_excerpt: $excerpt}'

[ "$healthy" = true ]
