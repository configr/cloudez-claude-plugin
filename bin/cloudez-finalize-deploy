#!/usr/bin/env bash
# Uso: cloudez-finalize-deploy <deploy_id>
#
# Ativa a release: troca o symlink `current` e limpa releases antigas.
# Equivalente a tool MCP cloudez_finalize_deploy.

source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

# Quantas releases ficam no servidor — e, portanto, ate onde o rollback alcanca.
# Constante em vez de config: nunca houve motivo real para variar por ambiente.
KEEP_RELEASES=5

# Quantos diretorios `.current-<release_id>` ficam no servidor.
#
# Numero SEPARADO, e menor, porque a natureza deles e outra: releases foram
# criadas por nos e podar e limpeza; um `.current-*` e o document root que o
# usuario tinha, posto de lado por nos. Apagar isso e apagar conteudo dele.
#
# No caminho normal existe no maximo UM: o primeiro deploy encontra o diretorio,
# move, e dali em diante `current` e symlink. A poda so chega a rodar quando
# alguem recria o diretorio a mao, repetidamente — e ai dois ja cobrem qualquer
# necessidade de voltar atras.
KEEP_REPLACED=2

deploy_id="${1:?uso: cloudez-finalize-deploy <deploy_id>}"

state=$(load_state "$deploy_id")
environment=$(printf '%s' "$state" | jq -r .environment)
site=$(site_config "$environment")

status=$(printf '%s' "$state" | jq -r .status)
[ "$status" = "uploaded" ] \
  || die upload_incomplete "Deploy esta em '$status'. Rode cloudez-sync antes de finalizar."

release_id=$(printf '%s' "$state" | jq -r .release_id)
root=$(printf '%s' "$state" | jq -r .root)

require_ssh_target "$site"

previous=$(ssh_run "$site" "readlink '$root/current' 2>/dev/null | xargs -r basename" || true)

# A troca do symlink e atomica via rename(2): `ln -s` num nome temporario e
# `mv -T` por cima. Um `rm current && ln -s` deixaria o site fora do ar na
# janela entre os dois comandos.
#
# `mv -T` e GNU coreutils. Roda no servidor (Linux), nao na maquina local —
# num host BSD/macOS falharia, e ai o mv moveria o link PARA DENTRO de current.
#
# O ALVO do link e relativo ao DIRETORIO DO LINK, nao ao cwd de quem o cria.
# `$root` e relativo ao $HOME (o `~/` foi removido para o shell remoto nao
# receber til dentro de aspas simples), entao usa-lo como alvo produz um link
# que so resolveria se `current` morasse no $HOME — e ele mora em `$root/`.
# O resultado e um link quebrado, `ls` e `ln` nao reclamam, e o site responde
# 404 depois de um deploy que se declarou bem-sucedido. `releases/<id>` e
# relativo ao proprio `$root/`, que e onde o link fica.
#
# `current` pode ser um DIRETORIO de verdade, e nao um symlink nosso: e o caso do
# site que ja tinha conteudo antes de o plugin entrar. `mv -T` de um link sobre
# um diretorio nao substitui — o rename(2) falha —, entao sem tratar isso o
# primeiro deploy morre em activation_failed sem dizer o motivo real.
#
# O teste precisa das DUAS condicoes. Um symlink que aponta para um diretorio
# tambem satisfaz `-d`: e exatamente o que o nosso `current` e depois do primeiro
# deploy. Com `-d` sozinho, todo deploy seguinte moveria o link valido para
# .current.old e o site cairia entre um comando e outro.
#
# O diretorio e movido, nunca apagado. Ele e o site que estava no ar.
#
# O destino leva o release_id: `.current-<release_id>`. Um nome fixo precisaria
# decidir o que fazer quando ja estivesse ocupado, e as duas saidas sao ruins —
# sobrescrever apaga um backup que o usuario pode nao ter conferido, e abortar
# trava o deploy por causa de um diretorio antigo. Com o release_id o problema
# nao existe, e de quebra da para saber qual deploy pos aquilo de lado.
activate="set -e
  ln -sfn 'releases/$release_id' '$root/.current.tmp.\$\$'
  if [ -d '$root/current' ] && [ ! -L '$root/current' ]; then
    mv '$root/current' '$root/.current-$release_id'
    echo 'MOVED $root/.current-$release_id'
  fi
  mv -Tf '$root/.current.tmp.\$\$' '$root/current'"

if ! out=$(ssh_run "$site" "$activate" 2>&1); then
  die activation_failed "Falha ao ativar a release $release_id." \
    "$(jq -n --arg l "$out" --argjson r true '{logs: $l, rollback_available: $r}')"
fi

# Limpeza best-effort: falhar aqui nao invalida um deploy que ja deu certo.
#
# Sem `set -e` de proposito: um `ls` que nao casa nada sai nao-zero, e isso e o
# caso normal quando nao ha o que podar.
#
# O stderr fica fora do que se le como dado — a licao do cloudez-list-releases.
prune="ls -1dt '$root/releases/'*/ 2>/dev/null | tail -n +$((KEEP_RELEASES + 1)) | xargs -r rm -rf
  old=\$(ls -1dt '$root/.current-'*/ 2>/dev/null | tail -n +$((KEEP_REPLACED + 1)))
  if [ -n \"\$old\" ]; then
    printf '%s\n' \"\$old\" | xargs -r rm -rf
    printf 'PRUNED %s\n' \"\$(printf '%s\n' \"\$old\" | wc -l | tr -d ' ')\"
  fi"

pruned=$(ssh_run "$site" "$prune" 2>/dev/null | awk '/^PRUNED /{print $2}') || true

# Ter movido um diretorio precisa chegar a quem chamou. E conteudo do usuario
# posto de lado, e ninguem alem dele decide se aquilo ainda serve para alguma
# coisa — silenciar aqui deixaria um diretorio orfao no servidor que so aparece
# quando alguem for olhar.
moved=$(printf '%s\n' "$out" | awk '/^MOVED /{print $2}')

# Campo que nao existe SOME do retorno, em vez de virar string vazia. E a mesma
# regra que o resto do plugin segue, e aqui ela tem consumidor: `""` sobrevive a
# um `if (previous_release_id)` em qualquer linguagem que trate string vazia como
# falsa, mas passa por um `if ("previous_release_id" in resposta)`. Ausente, os
# dois concordam.
#
# No primeiro deploy de um site nao ha release anterior, entao este e o caso
# comum, nao a excecao.
printf '%s' "$state" \
  | jq --arg prev "${previous:-}" --arg moved "${moved:-}" --arg pruned "${pruned:-}" \
      '.status = "succeeded"
       | if $prev   == "" then . else .previous_release_id = $prev   end
       | if $moved  == "" then . else .replaced_directory  = $moved  end
       | if $pruned == "" then . else .pruned_replaced = ($pruned | tonumber) end' \
  | tee "$(state_path "$deploy_id")"
