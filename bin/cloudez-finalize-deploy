#!/usr/bin/env bash
# Uso: cloudez-finalize-deploy <deploy_id>
#
# Ativa a release: troca o symlink `current` e limpa releases antigas.
# Equivalente a tool MCP cloudez_finalize_deploy.

source "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

# Quantas releases ficam no servidor — e, portanto, ate onde o rollback alcanca.
# Constante em vez de config: nunca houve motivo real para variar por ambiente.
KEEP_RELEASES=5

deploy_id="${1:?uso: cloudez-finalize-deploy <deploy_id>}"

state=$(load_state "$deploy_id")
environment=$(printf '%s' "$state" | jq -r .environment)
site=$(site_config "$environment")

status=$(printf '%s' "$state" | jq -r .status)
[ "$status" = "uploaded" ] \
  || die upload_incomplete "Deploy esta em '$status'. Rode cloudez-sync antes de finalizar."

release_id=$(printf '%s' "$state" | jq -r .release_id)
root=$(printf '%s' "$state" | jq -r .root)

require_ssh_target "$site"

previous=$(ssh_run "$site" "readlink '$root/current' 2>/dev/null | xargs -r basename" || true)

# A troca do symlink e atomica via rename(2): `ln -s` num nome temporario e
# `mv -T` por cima. Um `rm current && ln -s` deixaria o site fora do ar na
# janela entre os dois comandos.
#
# `mv -T` e GNU coreutils. Roda no servidor (Linux), nao na maquina local —
# num host BSD/macOS falharia, e ai o mv moveria o link PARA DENTRO de current.
#
# O ALVO do link e relativo ao DIRETORIO DO LINK, nao ao cwd de quem o cria.
# `$root` e relativo ao $HOME (o `~/` foi removido para o shell remoto nao
# receber til dentro de aspas simples), entao usa-lo como alvo produz um link
# que so resolveria se `current` morasse no $HOME — e ele mora em `$root/`.
# O resultado e um link quebrado, `ls` e `ln` nao reclamam, e o site responde
# 404 depois de um deploy que se declarou bem-sucedido. `releases/<id>` e
# relativo ao proprio `$root/`, que e onde o link fica.
activate="set -e
  ln -sfn 'releases/$release_id' '$root/.current.tmp.\$\$'
  mv -Tf '$root/.current.tmp.\$\$' '$root/current'"

if ! out=$(ssh_run "$site" "$activate" 2>&1); then
  die activation_failed "Falha ao ativar a release $release_id." \
    "$(jq -n --arg l "$out" --argjson r true '{logs: $l, rollback_available: $r}')"
fi

# Limpeza best-effort: falhar aqui nao invalida um deploy que ja deu certo.
ssh_run "$site" \
  "ls -1dt '$root/releases/'*/ 2>/dev/null | tail -n +$((KEEP_RELEASES + 1)) | xargs -r rm -rf" \
  >/dev/null 2>&1 || true

printf '%s' "$state" \
  | jq --arg prev "${previous:-}" \
      '.status = "succeeded" | .previous_release_id = $prev' \
  | tee "$(state_path "$deploy_id")"
